# =============================================================================
# Autonomous QA Multi-Agent Framework - environment template
# Copy to `.env` and fill in. Never commit `.env`.
#
# Nothing here is required for a first run: `python -m taf run TB-601 --provider
# offline` works with this file copied unchanged. `python -m taf doctor` tells
# you what is missing for a real one.
# =============================================================================

# --- LLM router (taf/llm/router.py) -------------------------------------------
#   auto    = claude when ANTHROPIC_API_KEY is set, otherwise ollama   (recommended)
#   claude  = agents 1-3 on Claude, report on Ollama
#   ollama  = every agent on Ollama - no key, no cloud cost (see docs/SETUP-ollama-only.md)
#   offline = no model at all; placeholder output that proves the pipeline runs
# Switch at runtime too: the dashboard's Model selector, `python -m taf providers
# --set ollama --server http://127.0.0.1:8000`, or `--provider` on a single run.
LLM_PROVIDER=auto
# Agents kept on Claude even when the provider is local (triage,architect,automation or all).
CLOUD_AGENTS=

# --- Cloud LLM: Claude (Agents 1-3), routed by task difficulty ---------------
# API key from console.anthropic.com (an API key, not a claude.ai seat). Leave empty
# to run locally - with LLM_PROVIDER=auto an empty key means Ollama.
ANTHROPIC_API_KEY=
# Effort: low | medium | high | xhigh | max. MAX_TOKENS includes thinking tokens.
# Agent 1 - Intake Triager: extraction + risk classification.
CLAUDE_TRIAGE_MODEL=claude-sonnet-5-5
CLAUDE_TRIAGE_EFFORT=medium
CLAUDE_TRIAGE_MAX_TOKENS=16000
# Agent 2 - Test Architect: risk-based test design.
CLAUDE_ARCHITECT_MODEL=claude-sonnet-5-5
CLAUDE_ARCHITECT_EFFORT=high
CLAUDE_ARCHITECT_MAX_TOKENS=32000
# Agent 3 - TS Automation Engineer: the hardest task (runnable code from a diff).
CLAUDE_AUTOMATION_MODEL=claude-opus-5-5
CLAUDE_AUTOMATION_EFFORT=high
CLAUDE_AUTOMATION_MAX_TOKENS=64000
CLAUDE_TIMEOUT_SECONDS=600
# Prices are built in for current models. Only set this for contract rates or new models:
# CLAUDE_PRICING_JSON={"claude-opus-5-5": {"input": 4, "output": 20, "cache_write_5m": 5, "cache_write_1h": 8, "cache_read": 0.2}}

# --- Prompt caching & spec repair --------------------------------------------
# Agents whose per-run context is cached: comma list of triage,architect,automation (or all).
# Only worth it where a prompt is re-sent - the Automation Engineer's repair loop.
PROMPT_CACHE_AGENTS=automation
# 5m (write 1.25x input price) or 1h (write 2x). Reads cost 0.05x on Opus 5.5, 0.1x on Sonnet 5.5.
PROMPT_CACHE_TTL=5m
# How often the model may fix a spec the checks rejected (0-3; 0 disables): validation
# failures (playwright --list, tsc, eslint, imports) and review blockers.
SPEC_REPAIR_ATTEMPTS=2
# How often failing tests go back to the model with their error and page snapshot after
# the run (0 disables). A repair that drops an assertion is rejected; only the failing
# tests are rerun.
RUN_REPAIR_ATTEMPTS=2

# --- Local LLM: Ollama + Qwen 2.5-Coder (Agent 4) ----------------------------
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_TIMEOUT_SECONDS=300

# --- Ollama per-agent models (used when an agent routes to ollama) -----------
# Optional per-agent models (default: OLLAMA_MODEL).
# OLLAMA_TRIAGE_MODEL=
# OLLAMA_ARCHITECT_MODEL=
# OLLAMA_AUTOMATION_MODEL=
# OLLAMA_MAX_TOKENS=4096

# --- Ticket source: real flow vs demo ---------------------------------------
# jira = real flow: tickets, descriptions and linked PRs come from the Jira API
#        (needs JIRA_BASE_URL / JIRA_EMAIL / JIRA_API_TOKEN below).
# seed = demo flow: data/seed_tickets.json (TB-601), no credentials needed.
# auto = jira when the three Jira variables are set, otherwise seed.
# Override per run: `python -m taf run TB-601 --source seed`.
TICKET_SOURCE=auto

# --- Source repository: where PR diffs come from ----------------------------
# The PRs linked to a ticket (Jira development panel, or `pull_requests` in a
# seed ticket) are fetched with git into a blobless bare clone kept at
# SOURCE_REPO_LOCAL_PATH (created on first use, ~15 MB). git uses your normal
# GitHub sign-in, so no token is needed - but you need read access to the repo.
# Without access, runs continue without a diff.
SOURCE_REPO_URL=https://github.com/TravelEdge/TripArc.TripBuilder.git
SOURCE_REPO_LOCAL_PATH=../tripbuilder-src.git
SOURCE_BASE_BRANCH=develop
FETCH_PR_DIFFS=true
# A real PR diff is far larger than a prompt (TB-601's #740 is ~370k chars). Before
# a model sees it, it is condensed: every changed file is listed, then full hunks
# for files under DIFF_FOCUS_PATHS (templates first, then components) until the
# budget - MAX_DIFF_CHARS, or OLLAMA_MAX_DIFF_CHARS on local models - is spent.
DIFF_FOCUS_PATHS=apps/
DIFF_EXCLUDE_GLOBS=*.lock,*package-lock.json,*pnpm-lock.yaml,*.md,*.snap,*.svg,*.png,*.jpg,*.jpeg,*.gif,*.ico,*.min.js,*.map
OLLAMA_MAX_DIFF_CHARS=6000

# --- TypeScript Playwright test repository -----------------------------------
# Generated specs go to github.com/regina-triparc/tripbuilder-e2e (private; ask
# for access). The agent keeps its OWN clone at TEST_REPO_LOCAL_PATH - cloned
# automatically on the first run, packages installed with `npm ci` - and per
# ticket it validates and runs e2e/qa/<TICKET>.spec.ts on main (removed again
# afterwards) and, once approved, commits it on qa/<TICKET>, pushes and opens a PR.
# Never work in that clone yourself; clone the repo a second time for that.
#
# Relative paths are resolved from this project's root, so the default puts the
# agent's clone next to it and works on any machine unchanged.
TEST_REPO_LOCAL_PATH=../tripbuilder-e2e-agent
TEST_REPO_URL=https://github.com/regina-triparc/tripbuilder-e2e.git
# false = managed clone (above). true = write and run the spec in place in an
# existing checkout, with no git operations at all (TEST_REPO_LOCAL_PATH must
# then point at that checkout, and nothing is pushed).
TEST_REPO_NO_GIT=false
TEST_REPO_BASE_BRANCH=main
# Folder (relative to the test repo root) where <TICKET>.spec.ts files are written.
TEST_SPEC_DIR=e2e/qa
GIT_PUSH_ENABLED=true
# Usually empty: git uses your normal GitHub sign-in (Git Credential Manager on
# Windows/macOS). If pushes are rejected, a fine-grained PAT with "Contents:
# Read and write" on tripbuilder-e2e only (plus "Pull requests: read and write" for
# PR_CREATE_ENABLED). Sent as an auth header, never in the URL.
GITHUB_TOKEN=
# The test login (TBA_E2E_EMAIL / TBA_E2E_PASSWORD) the generated specs sign in
# with. Point this at a .env holding them - e.g. your own working copy's
# ../tripbuilder-e2e/.env - and they are passed to Playwright without copying
# any secrets into the agent's clone. Alternatively put a .env in the clone.
TEST_REPO_ENV_FILE=
GIT_AUTHOR_NAME=QA Agent
GIT_AUTHOR_EMAIL=qa-agent@users.noreply.github.com
GIT_TIMEOUT_SECONDS=120
# tripbuilder-e2e has a package-lock.json, so npm (pnpm would re-resolve the tree).
PACKAGE_MANAGER=npm
# true = install once when node_modules is missing, then reuse it on every run.
SKIP_DEPENDENCY_INSTALL=true

# --- pnpm / Playwright execution ---------------------------------------------
PNPM_INSTALL_TIMEOUT_SECONDS=600
PLAYWRIGHT_TIMEOUT_SECONDS=1800
# Set true to run `playwright install --with-deps chromium` before each run.
PLAYWRIGHT_INSTALL_BROWSERS=false
# --project=qa-agent: the Playwright project in tripbuilder-e2e that runs e2e/qa/ after sign-in.
PLAYWRIGHT_EXTRA_ARGS=--reporter=line --project=qa-agent

# --- Workflow: checkpoints, approval, pull requests ---------------------------
# (docs/WORKFLOW-OBSERVABILITY-EVALS.md)
# LangGraph checkpoints: lets `python -m taf resume <run_id>` continue a crashed run or
# one waiting for approval. Its own file; qa_runs.db is not changed.
QA_CHECKPOINT_DB_PATH=qa_checkpoints.db
# Pause before anything leaves the machine (push / pull request) until a person approves
# on the dashboard or with `python -m taf resume <run_id> --approve`.
REQUIRE_APPROVAL=true
# Open a pull request in the test repo after an approved push. Needs GITHUB_TOKEN with
# "Pull requests: read and write", or a signed-in GitHub CLI (gh). Off while developing.
PR_CREATE_ENABLED=false
# Optional model review of the spec (conventions, maintainability); blockers trigger a repair.
REVIEW_WITH_LLM=false
# CLAUDE_REVIEW_MODEL=claude-sonnet-5-5
# CLAUDE_REVIEW_EFFORT=medium
# OLLAMA_REVIEW_MODEL=
# How much of the test repo's conventions (page objects, fixtures, example spec) the
# Automation Engineer is shown.
REPO_CONTEXT_MAX_CHARS=14000

# --- Langfuse (optional LLM observability) ------------------------------------
# Both keys set = tracing on. Without them, or if Langfuse is down, runs are unaffected.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Empty = Langfuse Cloud EU. e.g. https://us.cloud.langfuse.com or your self-hosted URL.
LANGFUSE_BASE_URL=
LANGFUSE_ENABLED=true
# Environment for QA runs (evals always use "eval").
LANGFUSE_ENVIRONMENT=local
# metadata = no prompt/response text | truncated (default) | full. Secrets are always redacted.
LANGFUSE_CAPTURE=truncated
LANGFUSE_MAX_FIELD_CHARS=4000
LANGFUSE_TIMEOUT_SECONDS=5
LANGFUSE_FLUSH_TIMEOUT_SECONDS=10

# --- Paperclip Control Room & budget guard -----------------------------------
# Paperclip server (no /api suffix) and the QA agent's API key. Company and agent
# IDs are discovered from the key. Leave either empty to disable Paperclip.
PAPERCLIP_API_URL=http://localhost:3100
PAPERCLIP_API_KEY=
# Optional: project name (or UUID) that QA issues are filed under.
PAPERCLIP_PROJECT=QA Automation
# Refuse Claude calls while Paperclip has the agent paused / over its monthly budget.
PAPERCLIP_ENFORCE_BUDGET=true
# Local hard caps on Claude tokens (input + output; prompt-cache reads excluded). 0 = off.
MAX_CLOUD_TOKENS_PER_RUN=250000
MAX_CLOUD_TOKENS_PER_DAY=2000000

# --- Xray test cases (written to the test repo, exported after review) --------
# Jira project the tests are created in. Empty = the ticket's own project (SHOP-123 → SHOP).
XRAY_PROJECT_KEY=
# Xray test-repository folder; {ticket_id} is replaced. Empty = repository root.
XRAY_TEST_FOLDER=AI QA/{ticket_id}
# Jira link type between each Test and the story ("Test" = Xray's "tests / is tested by").
XRAY_REQUIREMENT_LINK_TYPE=Test
# Send priority names (Highest…Lowest). Only enable if your Jira uses those names.
XRAY_INCLUDE_PRIORITY=false
# Each ticket's test cases are written to <test repo>/XRAY_DIR/<TICKET>/ and committed with
# the spec for review; `python -m taf xray export <TICKET>` imports the merged version.
XRAY_DIR=xray

# --- HTML run report -----------------------------------------------------------
# The Report Synthesizer also writes <REPORTS_DIR>/<TICKET>-<run>.html: a manual
# checklist pre-filled from the automation run, with screenshots and gaps.
REPORTS_DIR=reports
# Screenshots inlined into one report (each up to 2 MB); the rest are left out.
REPORT_MAX_SCREENSHOTS=40
# Only for `taf xray export --apply` (Xray Cloud > Settings > API Keys).
XRAY_CLIENT_ID=
XRAY_CLIENT_SECRET=
XRAY_BASE_URL=https://xray.cloud.getxray.app

# --- Service -----------------------------------------------------------------
# Shared secret for POST /qa/runs (the optional n8n integration), sent as `X-API-Key`.
# The dashboard and CLI do not use it. Empty = no auth.
QA_SERVICE_API_KEY=change-me-to-a-long-random-string
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
MAX_DIFF_CHARS=120000
MAX_ENV_LOG_CHARS=40000
MAX_EXEC_LOG_CHARS_FOR_LLM=60000
CALLBACK_TIMEOUT_SECONDS=30

# =============================================================================
# Local-model tuning, skills, page contract, dashboard
# =============================================================================
# Local-model output cap per call, and the Test Architect's plan-size cap. A small
# model cannot finish a 20-case plan under a JSON-schema grammar.
OLLAMA_MAX_TOKENS=4096
OLLAMA_MAX_TEST_CASES=5
# Real roles/names captured from the app under test; stops the agent inventing selectors.
# Relative paths are resolved from the project root. The bundled one is for TripBuilder TSP.
PAGE_CONTRACT_PATH=skills/page-contracts/tripbuilder-tsp.md
# Before the spec is written, open the live app with the test repo's saved session
# (e2e/.auth/state.json) and record the accessibility tree of the states listed in the
# recipe (default: the page contract's .snapshot.json). Read-only. Skipped when the
# recipe or session is missing.
LIVE_SNAPSHOT_ENABLED=true
LIVE_SNAPSHOT_RECIPE=
LIVE_SNAPSHOT_MAX_CHARS=12000

# --- Skills (skills/*/SKILL.md appended to agent prompts; see skills/README.md) -
SKILLS_ENABLED=true
# Also on Ollama routes. Off by default: a small context window fills fast.
SKILLS_ON_LOCAL=false
SKILLS_MAX_CHARS=12000

# --- Dashboard ---------------------------------------------------------------
# Target for runs started from the dashboard or `taf run` without --target-url.
# Set to the TripBuilder portal because the seeded ticket (TB-601) is a TripBuilder story.
DASHBOARD_TARGET_URL=https://tripbuilder.dev.triparcdev.com/
# SQLite file holding run history and per-phase artifacts (relative = project root).
QA_DB_PATH=qa_runs.db
# Tickets the board and CLI use while Jira is not configured. Ships with TB-601.
SEED_TICKETS_PATH=data/seed_tickets.json

# --- Jira (dashboard queue; without these the board reads dashboard_seed.json) -
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_JQL=status in ("Ready for QA", "IN QA") ORDER BY updated DESC
JIRA_POLL_SECONDS=60
JIRA_TIMEOUT_SECONDS=20
