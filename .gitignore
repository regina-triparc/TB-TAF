# --- Secrets -----------------------------------------------------------------
.env
.env.*
!.env.example

# --- Byte-compiled / optimized -----------------------------------------------
__pycache__/
*.py[cod]
*$py.class

# --- Virtual environments ----------------------------------------------------
.venv/
venv/
env/
ENV/

# --- Distribution / packaging ------------------------------------------------
build/
dist/
*.egg-info/
.eggs/
wheels/

# --- Test / coverage / tooling caches ----------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.tox/
.nox/

# --- Logs --------------------------------------------------------------------
*.log
logs/

# --- IDE / OS ----------------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# --- Accidental local test-repo clones / Playwright output --------------------
node_modules/
test-results/
playwright-report/

# --- Run store (SQLite, recreated on first start) ------------------------------
*.db
*.db-journal
*.db-wal
*.db-shm

# --- Playwright test repos must never be committed here ----------------------
# Generated tests live in github.com/regina-triparc/tripbuilder-e2e. These names
# only guard against a copy or clone ending up inside this folder by mistake.
/search-e2e/
/tripbuilder-e2e*/

# --- Eval output ---------------------------------------------------------------
evals/results/
